{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Blankfire",
  "version": "1.9.1",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://lite-api.jup.ag/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trade.padre.gg/*"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "content/*.js",
        "content/*.css",
        "fonts/*.woff2",
        "icons/*.svg"
      ],
      "matches": [
        "https://trade.padre.gg/*"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdToggle__"
    }
  },
  "default_locale": "en"
}